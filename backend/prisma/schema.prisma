// Studio Botema ERP — Database Schema
// PostgreSQL via Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── AUTH ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices          Invoice[]
  documents         Document[]
  reviewedDocuments Document[] @relation("ReviewedDocuments")
  alerts            Alert[]

  @@map("users")
}

enum Role {
  ADMIN
  STAFF
  VIEWER
}

// ─── COMPANY ─────────────────────────────────────────────────────────────────

model Company {
  id       String  @id @default(cuid())
  name     String
  eik      String  @unique
  vat      String
  address  String
  city     String
  mol      String
  bankIban String
  bankBic  String
  bankName String
  email    String?
  phone    String?
  website  String?
  brand    Brand   @default(STUDIO_BOTEMA)

  @@map("companies")
}

enum Brand {
  STUDIO_BOTEMA
  LUMINAVERA
}

// ─── CLIENTS ─────────────────────────────────────────────────────────────────

// LEGACY — заменена от Counterparty(type=CLIENT). Не се пише/чете от нищо
// живо след migrateClientsSuppliersToCounterparty.js; държим таблицата няколко
// дни като safety net преди физическо изтриване.
model Client {
  id        String     @id @default(cuid())
  name      String
  eik       String?
  vat       String?
  city      String?
  address   String?
  mol       String?
  email     String?
  phone     String?
  type      ClientType @default(COMPANY)
  brand     Brand      @default(STUDIO_BOTEMA)
  since     Int?
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  invoices Invoice[]
  projects Project[]

  @@map("clients")
}

enum ClientType {
  COMPANY
  PERSON
  ET
}

// ─── SUPPLIERS ───────────────────────────────────────────────────────────────

// LEGACY — заменена от Counterparty(type=SUPPLIER). Не се пише/чете от нищо
// живо след migrateClientsSuppliersToCounterparty.js; държим таблицата няколко
// дни като safety net преди физическо изтриване.
model Supplier {
  id        String   @id @default(cuid())
  name      String
  country   String?
  currency  String   @default("EUR")
  discount  String?
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())

  purchases Purchase[]
  inventory InventoryItem[]

  @@map("suppliers")
}

// ─── PROJECTS ────────────────────────────────────────────────────────────────

model Project {
  id        String        @id @default(cuid())
  code      String        @unique // e.g. "1717.183"
  name      String
  clientId  String?       // LEGACY → Client. Safety-net; not written going forward.
  client    Client?       @relation(fields: [clientId], references: [id])
  counterpartyId String?  // → Counterparty(type=CLIENT), authoritative going forward
  counterparty    Counterparty? @relation("ProjectClient", fields: [counterpartyId], references: [id])
  status    ProjectStatus @default(ACTIVE)
  year      Int
  notes     String?
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Deal pipeline — tracks the sales/fulfillment cycle so status isn't locked
  // in one person's head (оферта → ... → затворено). See backend/src/lib/dealStages.js.
  dealStage          DealStage?
  dealStageOwner     String?   // "Жоро" | "Илиян" | "Стефи" — whoever currently owns advancing this stage
  dealStageUpdatedAt DateTime?
  designerId         String?
  designer           Counterparty? @relation("ProjectDesigner", fields: [designerId], references: [id])
  commissionPct      Float?    // designer/architect commission, e.g. 10 = 10%

  invoices     Invoice[]
  purchases    Purchase[]
  inventory    InventoryItem[]
  alerts       Alert[]
  bizDocuments BizDocument[]
  orders       Order[]
  deliveries   Delivery[]
  payments     Payment[]
  missing      MissingDocument[]

  @@map("projects")
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

// Mirrors the as-is process in the ERP spec: offer -> proforma -> advance ->
// ordered from supplier(s) -> designer commission paid -> goods arrived ->
// warehoused (Micro.bg) -> zero-value invoice handed to client -> closed.
enum DealStage {
  OFFER_SENT       // Оферта изпратена
  CLIENT_APPROVED  // Одобрена от клиент
  PROFORMA_ISSUED  // Проформа издадена (+ % аванс)
  ADVANCE_PAID     // Авансът платен
  ORDERED          // Поръчано при производител(и)
  COMMISSION_PAID  // Платен комисион на дизайнер/архитект
  GOODS_ARRIVED    // Стоката пристигнала
  WAREHOUSED       // Заведена в склад (Micro.bg)
  INVOICED_ZERO    // Издадена нулева фактура / предадена на клиент
  CLOSED           // Затворено
}

// ─── INVOICES (OUTGOING) ─────────────────────────────────────────────────────

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  date        DateTime
  dueDate     DateTime?
  clientId    String?       // LEGACY → Client. Safety-net; not written going forward.
  client      Client?       @relation(fields: [clientId], references: [id])
  counterpartyId String?    // → Counterparty(type=CLIENT), authoritative going forward
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id])
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id])
  type        InvoiceType   @default(INVOICE)
  status      PaymentStatus @default(PENDING)
  brand       Brand         @default(STUDIO_BOTEMA)
  currency    String        @default("BGN")
  amountNet   Decimal       @db.Decimal(12, 2)
  vatAmount   Decimal       @db.Decimal(12, 2)
  amountTotal Decimal       @db.Decimal(12, 2)
  description String?
  notes       String?
  driveFileId String? // Google Drive file ID
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items  InvoiceItem[]
  alerts Alert[]

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  qty         Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  vatPct      Decimal @default(20) @db.Decimal(5, 2)
  total       Decimal @db.Decimal(12, 2)
  unit        String? // бр, м², кг, л, м, компл.
  imageUrl    String? // product image URL (for offers)
  sortOrder   Int     @default(0)

  @@map("invoice_items")
}

enum InvoiceType {
  INVOICE
  PROFORMA
  CREDIT_NOTE
  OFFER
  DELIVERY_NOTE
  PROTOCOL
  WARRANTY
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

// ─── PURCHASES (INCOMING) ────────────────────────────────────────────────────

model Purchase {
  id          String        @id @default(cuid())
  invoiceNo   String?
  date        DateTime
  supplierId  String        // LEGACY → Supplier. Safety-net; not written going forward.
  supplier    Supplier      @relation(fields: [supplierId], references: [id])
  counterpartyId String?    // → Counterparty(type=SUPPLIER), authoritative going forward
  counterparty    Counterparty? @relation(fields: [counterpartyId], references: [id])
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id])
  currency    String        @default("EUR")
  amount      Decimal       @db.Decimal(12, 2)
  description String?
  status      PaymentStatus @default(PAID)
  driveFileId String?
  year        Int
  createdAt   DateTime      @default(now())

  items  PurchaseItem[]
  alerts Alert[]

  @@map("purchases")
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  code        String?
  description String
  qty         Decimal  @db.Decimal(10, 3)
  unitPrice   Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)

  @@map("purchase_items")
}

// ─── INVENTORY ───────────────────────────────────────────────────────────────

model InventoryItem {
  id         String       @id @default(cuid())
  supplierId String        // LEGACY → Supplier. Safety-net; not written going forward.
  supplier   Supplier     @relation(fields: [supplierId], references: [id])
  counterpartyId String?  // → Counterparty(type=SUPPLIER), authoritative going forward
  counterparty    Counterparty? @relation(fields: [counterpartyId], references: [id])
  projectId  String?
  project    Project?     @relation(fields: [projectId], references: [id])
  code       String
  name       String
  category   ItemCategory @default(LIGHTING)
  account    String? // счетоводна сметка
  qtyIn      Decimal      @default(0) @db.Decimal(10, 3)
  qtyOut     Decimal      @default(0) @db.Decimal(10, 3)
  location   String?
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  movements StockMovement[]

  @@map("inventory_items")
}

model StockMovement {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id])
  type      MovementType
  qty       Decimal       @db.Decimal(10, 3)
  date      DateTime
  reference String?
  notes     String?
  createdAt DateTime      @default(now())

  @@map("stock_movements")
}

enum MovementType {
  IN // доставка
  OUT // изписване
  SAMPLE // мостра
  RETURN // връщане
  ADJUST // корекция
}

enum ItemCategory {
  LIGHTING // осветителни тела
  ELECTRICAL // ел. материали
  SAMPLE // мостри
  FURNITURE // мебели
  MIRROR // огледала
  OTHER
}

// ─── EXPENSES ────────────────────────────────────────────────────────────────

model Expense {
  id          String   @id @default(cuid())
  date        DateTime
  category    String
  supplier    String
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("EUR")
  year        Int
  createdAt   DateTime @default(now())

  @@map("expenses")
}

// ─── DOCUMENTS ───────────────────────────────────────────────────────────────

model Document {
  id              String          @id @default(cuid())
  driveFileId     String          @unique
  driveUrl        String
  filename        String
  type            DocType
  status          DocStatus       @default(PENDING)
  extractedData   Json? // AI extracted data
  confidence      Decimal?        @db.Decimal(5, 2)
  suggestedAction DocumentAction?
  duplicateOfId   String?
  riskFlags       Json?
  processedAt     DateTime?
  createdById     String?
  createdBy       User?           @relation(fields: [createdById], references: [id])
  reviewedById    String?
  reviewedBy      User?           @relation("ReviewedDocuments", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime        @default(now())

  alerts Alert[]

  @@map("documents")
}

enum DocumentAction {
  CREATE_PURCHASE
  CREATE_INVOICE
  CREATE_EXPENSE
  ARCHIVE_ONLY
  REJECT
}

enum DocType {
  INVOICE_IN
  INVOICE_OUT
  PROFORMA
  DELIVERY
  OTHER
}

enum DocStatus {
  PENDING // чака обработка
  PROCESSED // обработен
  LINKED // свързан с фактура
  REJECTED // отхвърлен
}

// ─── ALERTS ──────────────────────────────────────────────────────────────────

model Alert {
  id           String        @id @default(cuid())
  type         AlertType
  severity     AlertSeverity @default(WARNING)
  status       AlertStatus   @default(ACTIVE)
  title        String
  description  String
  metadata     Json?
  documentId   String?
  document     Document?     @relation(fields: [documentId], references: [id])
  invoiceId    String?
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id])
  purchaseId   String?
  purchase     Purchase?     @relation(fields: [purchaseId], references: [id])
  projectId    String?
  project      Project?      @relation(fields: [projectId], references: [id])
  createdById  String?
  createdBy    User?         @relation(fields: [createdById], references: [id])
  detectedAt   DateTime      @default(now())
  resolvedAt   DateTime?
  snoozedUntil DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, severity])
  @@index([type, status])
  @@map("alerts")
}

enum AlertType {
  DOCUMENT
  VAT
  REVENUE
  EXPENSE
  PROJECT
  DATA_QUALITY
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  RESOLVED
  SNOOZED
}

// ─── GMAIL WATCH ─────────────────────────────────────────────────────────────

model GmailWatch {
  id         String   @id @default(cuid())
  email      String   @unique
  historyId  String
  expiration DateTime
  active     Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  @@map("gmail_watches")
}

// ─── GMAIL INBOX MESSAGES ─────────────────────────────────────────────────────

model GmailMessage {
  id              String             @id @default(cuid())
  messageId       String             @unique
  threadId        String?
  subject         String
  from            String?
  snippet         String?
  date            DateTime?
  hasAttachments  Boolean            @default(false)
  attachmentNames String[]
  bodyText        String?
  status          GmailMessageStatus @default(PENDING)
  classification  String?
  classifiedType  String?            // INVOICE_IN, INVOICE_OUT, DELIVERY, PAYMENT, INQUIRY, OTHER
  notes           String?
  reviewedAt      DateTime?
  reviewedById    String?
  documentId      String?            // linked document after processing
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("gmail_messages")
}

enum GmailMessageStatus {
  PENDING
  CLASSIFIED
  IGNORED
}

// ═══════════════════════════════════════════════════════════════════════════════
// NORMALIZED BUSINESS DATA LAYER
// Таблици за нормализирания import от Drive/Gmail
// ═══════════════════════════════════════════════════════════════════════════════

// ─── COUNTERPARTIES ──────────────────────────────────────────────────────────
// Обединена таблица: клиенти, доставчици, куриери, банки, счетоводство

model Counterparty {
  id          String          @id @default(cuid())
  name        String
  type        CounterpartyType
  subtype     String?         // "COURIER", "BANK", "ACCOUNTING", "CUSTOMS" etc.
  isIndividual Boolean        @default(false)  // физическо лице
  eik         String?
  vat         String?
  country     String          @default("BG")
  currency    String          @default("BGN")
  address     String?
  city        String?
  email       String?
  phone       String?
  website     String?
  logoUrl     String?         // logo image URL (Clearbit or manual)
  notes       String?
  companyId   String?         // Studio Botema
  // Полета мигрирани от legacy Client (виж migrateClientsSuppliersToCounterparty.js) —
  // само за type=CLIENT редове, но държани тук, за да няма втора таблица.
  mol         String?         // МОЛ (материално отговорно лице), само за клиенти
  since       Int?            // година на onboarding, само за клиенти
  clientType  ClientType?     // COMPANY/PERSON/ET, по-фин от isIndividual
  brand       Brand?          // STUDIO_BOTEMA/LUMINAVERA — канал за издадени фактури
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  contacts            Contact[]
  ordersAsClient      Order[]              @relation("OrderClient")
  ordersAsSupplier    Order[]              @relation("OrderSupplier")
  deliveries          Delivery[]
  bizDocuments        BizDocument[]
  payments            Payment[]
  missingDocuments    MissingDocument[]
  designedProjects    Project[]            @relation("ProjectDesigner")
  invoices            Invoice[]
  projects            Project[]            @relation("ProjectClient")
  purchases           Purchase[]
  inventory           InventoryItem[]

  @@index([type])
  @@index([name])
  @@map("counterparties")
}

enum CounterpartyType {
  CLIENT
  SUPPLIER
  COURIER
  BANK
  ACCOUNTING
  DESIGNER // дизайнер / архитект — получава комисион, не е клиент или доставчик
  OTHER
}

// ─── CONTACTS ────────────────────────────────────────────────────────────────

model Contact {
  id              String       @id @default(cuid())
  counterpartyId  String
  counterparty    Counterparty @relation(fields: [counterpartyId], references: [id])
  name            String
  email           String?
  phone           String?
  role            String?
  notes           String?
  createdAt       DateTime     @default(now())

  @@map("contacts")
}

// ─── SOURCE FILES ─────────────────────────────────────────────────────────────
// Оригинални Drive/Gmail файлове

model SourceFile {
  id          String     @id @default(cuid())
  type        SourceType
  driveFileId String?    @unique
  driveUrl    String?
  gmailMsgId  String?    @unique
  gmailThread String?
  filename    String
  mimeType    String?
  folder      String?    // Drive folder path
  subject     String?    // Email subject
  fromEmail   String?
  receivedAt  DateTime?
  processedAt DateTime?
  notes       String?
  createdAt   DateTime   @default(now())

  bizDocuments BizDocument[]
  emailThread  EmailThread?  @relation(fields: [gmailThread], references: [threadId])

  @@map("source_files")
}

enum SourceType {
  DRIVE
  GMAIL
  MANUAL
}

// ─── EMAIL THREADS ────────────────────────────────────────────────────────────

model EmailThread {
  id              String    @id @default(cuid())
  threadId        String    @unique // Gmail thread ID
  subject         String
  fromEmail       String?
  counterpartyId  String?
  lastMessageAt   DateTime?
  messageCount    Int       @default(1)
  hasAttachments  Boolean   @default(false)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sourceFiles SourceFile[]

  @@map("email_threads")
}

// ─── BIZ DOCUMENTS ────────────────────────────────────────────────────────────
// Нормализирани бизнес документи (фактури, проформи, оферти, протоколи, ДН)

model BizDocument {
  id              String          @id @default(cuid())
  companyId       String?         // Studio Botema
  counterpartyId  String?
  counterparty    Counterparty?   @relation(fields: [counterpartyId], references: [id])
  projectId       String?
  project         Project?        @relation(fields: [projectId], references: [id])
  sourceFileId    String?
  sourceFile      SourceFile?     @relation(fields: [sourceFileId], references: [id])
  docType         BizDocType
  docNumber       String?
  docDate         DateTime?
  dueDate         DateTime?
  currency        String          @default("BGN")
  amountNet       Decimal?        @db.Decimal(14, 4)
  vatAmount       Decimal?        @db.Decimal(14, 4)
  amountTotal     Decimal?        @db.Decimal(14, 4)
  vatType         VatType         @default(STANDARD_BG)
  status          BizDocStatus    @default(NEW)
  confidence      Decimal?        @db.Decimal(5, 2)
  notes           String?
  internalRef     String?         // наш вътрешен reference
  externalRef     String?         // reference от контрагента
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  lines               BizDocumentLine[]
  reconciliationLinks ReconciliationLink[] @relation("SourceDoc")
  linkedTo            ReconciliationLink[] @relation("TargetDoc")
  missingDocuments    MissingDocument[]

  @@index([docType, status])
  @@index([counterpartyId])
  @@index([docDate])
  @@map("biz_documents")
}

model BizDocumentLine {
  id          String      @id @default(cuid())
  docId       String
  doc         BizDocument @relation(fields: [docId], references: [id], onDelete: Cascade)
  lineNo      Int?
  code        String?
  description String
  qty         Decimal?    @db.Decimal(12, 4)
  unit        String?
  unitPrice   Decimal?    @db.Decimal(14, 4)
  vatPct      Decimal?    @db.Decimal(5, 2)
  total       Decimal?    @db.Decimal(14, 4)
  notes       String?

  @@map("biz_document_lines")
}

enum BizDocType {
  INVOICE_OUT      // изходяща фактура
  INVOICE_IN       // входяща фактура
  PROFORMA_OUT
  PROFORMA_IN
  OFFER_OUT        // оферта към клиент
  OFFER_IN         // оферта от доставчик
  CREDIT_NOTE
  DELIVERY_NOTE    // стокова разписка / ДН
  CMR              // товарителница
  PROTOCOL         // приемо-предавателен протокол
  CUSTOMS          // митнически документ
  BANK_STATEMENT
  OTHER
}

enum BizDocStatus {
  NEW
  NEEDS_REVIEW
  REVIEWED
  IMPORTED         // вкаран в ERP
  MATCHED          // свързан с плащане/доставка
  ARCHIVED
  REJECTED
}

enum VatType {
  STANDARD_BG      // БГ ДДС 20%
  EU_INTRA         // вътреобщностна доставка
  REVERSE_CHARGE   // обратно начисляване
  EXEMPT           // освободена
  NON_VAT          // не е предмет на ДДС
  IMPORT           // внос / митница
}

// ─── ORDERS ──────────────────────────────────────────────────────────────────

model Order {
  id              String        @id @default(cuid())
  companyId       String?
  clientId        String?
  client          Counterparty? @relation("OrderClient", fields: [clientId], references: [id])
  supplierId      String?
  supplier        Counterparty? @relation("OrderSupplier", fields: [supplierId], references: [id])
  projectId       String?
  project         Project?      @relation(fields: [projectId], references: [id])
  orderType       OrderType
  orderNo         String?
  orderDate       DateTime?
  currency        String        @default("EUR")
  amountTotal     Decimal?      @db.Decimal(14, 4)
  status          OrderStatus   @default(OPEN)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lines      OrderLine[]
  deliveries Delivery[]

  @@index([orderType, status])
  @@map("orders")
}

model OrderLine {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineNo      Int?
  code        String?
  description String
  qty         Decimal @db.Decimal(12, 4)
  unit        String?
  unitPrice   Decimal @db.Decimal(14, 4)
  currency    String  @default("EUR")
  notes       String?

  @@map("order_lines")
}

enum OrderType {
  CLIENT_ORDER    // от клиент
  SUPPLIER_ORDER  // към доставчик
}

enum OrderStatus {
  OPEN
  PARTIAL
  FULFILLED
  CANCELLED
}

// ─── DELIVERIES ──────────────────────────────────────────────────────────────

model Delivery {
  id              String        @id @default(cuid())
  orderId         String?
  order           Order?        @relation(fields: [orderId], references: [id])
  counterpartyId  String?
  counterparty    Counterparty? @relation(fields: [counterpartyId], references: [id])
  projectId       String?
  project         Project?      @relation(fields: [projectId], references: [id])
  deliveryType    DeliveryType
  deliveryNo      String?
  deliveryDate    DateTime?
  courier         String?
  trackingNo      String?
  status          DeliveryStatus @default(IN_TRANSIT)
  hasInvoice      Boolean       @default(false)
  invoiceValue    Decimal?      @db.Decimal(14, 4)
  currency        String        @default("EUR")
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([deliveryType, status])
  @@map("deliveries")
}

enum DeliveryType {
  INBOUND   // входяща доставка
  OUTBOUND  // изходяща доставка
  RETURN    // връщане
}

enum DeliveryStatus {
  IN_TRANSIT
  DELIVERED
  PARTIAL
  RETURNED
  CANCELLED
}

// ─── PAYMENTS ────────────────────────────────────────────────────────────────

model Payment {
  id              String        @id @default(cuid())
  companyId       String?
  counterpartyId  String?
  counterparty    Counterparty? @relation(fields: [counterpartyId], references: [id])
  projectId       String?
  project         Project?      @relation(fields: [projectId], references: [id])
  paymentType     PaymentType
  paymentDate     DateTime
  amount          Decimal       @db.Decimal(14, 4)
  currency        String        @default("BGN")
  reference       String?       // bank ref / COD ref
  bankAccount     String?
  status          PaymentMatchStatus @default(UNMATCHED)
  // Cash-flow category (bank-first accounting): INCOME | PURCHASE | SALARY | TAX |
  // RENT | BANK_FEE | SOFTWARE_ADS | LOGISTICS | SERVICES | CASH | OTHER
  category        String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  reconciliationLinks ReconciliationLink[]

  @@index([paymentType, status])
  @@index([paymentDate])
  @@map("payments")
}

enum PaymentType {
  BANK_TRANSFER
  COD             // наложен платеж
  CARD
  CASH
  OTHER
}

enum PaymentMatchStatus {
  UNMATCHED
  PARTIAL
  MATCHED
}

// ─── RECONCILIATION LINKS ────────────────────────────────────────────────────
// Логическите връзки между документи, плащания и доставки

model ReconciliationLink {
  id            String      @id @default(cuid())
  sourceDocId   String?
  sourceDoc     BizDocument? @relation("SourceDoc", fields: [sourceDocId], references: [id])
  targetDocId   String?
  targetDoc     BizDocument? @relation("TargetDoc", fields: [targetDocId], references: [id])
  paymentId     String?
  payment       Payment?    @relation(fields: [paymentId], references: [id])
  linkType      LinkType
  amountLinked  Decimal?    @db.Decimal(14, 4)
  currency      String?
  confidence    Decimal?    @db.Decimal(5, 2)
  notes         String?
  createdAt     DateTime    @default(now())

  @@index([linkType])
  @@map("reconciliation_links")
}

enum LinkType {
  PAYMENT_TO_INVOICE
  INVOICE_TO_DELIVERY
  DELIVERY_TO_ORDER
  ORDER_TO_PROJECT
  DOCUMENT_TO_SOURCE
  EMAIL_TO_DOCUMENT
  PARTIAL_MATCH
}

// ─── MISSING DOCUMENTS ───────────────────────────────────────────────────────

model MissingDocument {
  id              String       @id @default(cuid())
  counterpartyId  String?
  counterparty    Counterparty? @relation(fields: [counterpartyId], references: [id])
  projectId       String?
  project         Project?     @relation(fields: [projectId], references: [id])
  relatedDocId    String?
  relatedDoc      BizDocument? @relation(fields: [relatedDocId], references: [id])
  missingType     MissingType
  description     String
  expectedAmount  Decimal?     @db.Decimal(14, 4)
  currency        String?
  status          MissingStatus @default(OPEN)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("missing_documents")
}

enum MissingType {
  ADVANCE_INVOICE   // аванс фактура
  FINAL_INVOICE     // финална фактура
  DELIVERY_NOTE     // липсваща стокова разписка
  PAYMENT_PROOF     // липсващо плащане
  CUSTOMS_DOC       // митнически документ
  OTHER
}

enum MissingStatus {
  OPEN
  FOUND
  WRITTEN_OFF
}

// ─── COVERAGE ────────────────────────────────────────────────────────────────
// Tracking на Drive/Gmail обхождане

model Coverage {
  id          String         @id @default(cuid())
  source      CoverageSource
  path        String         // Drive folder path или Gmail label/filter
  year        Int
  status      CoverageStatus @default(PENDING)
  itemsFound  Int            @default(0)
  itemsDone   Int            @default(0)
  notes       String?
  lastRunAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([source, path, year])
  @@map("coverage")
}

enum CoverageSource {
  DRIVE
  GMAIL
}

enum CoverageStatus {
  PENDING
  IN_PROGRESS
  DONE
  PARTIAL
}

