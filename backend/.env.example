# ─── Database (Supabase) ──────────────────────────────────────────────────────
# Pooler URL (used at runtime for queries)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection URL (used by Prisma migrations / db push — bypasses pooler)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-string-minimum-32-chars"
ADMIN_PASSWORD="your-admin-password"

# ─── AI (Gemini primary, others optional fallbacks) ───────────────────────────
GEMINI_API_KEY="AIza..."
GROQ_API_KEY=""           # optional — fallback if Gemini is down
OPENROUTER_API_KEY=""     # optional — second fallback

# ─── Google OAuth & Gmail ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."
GOOGLE_REDIRECT_URI="http://localhost:3001/api/auth/google/callback"
GOOGLE_REFRESH_TOKEN="1//..."
GOOGLE_PROJECT_ID="botema-erp"

# ─── Google Drive ─────────────────────────────────────────────────────────────
DRIVE_INVOICES_FOLDER_ID="your-drive-folder-id"

# ─── Gmail Watch (Pub/Sub) ────────────────────────────────────────────────────
PUBSUB_TOPIC="botema-gmail-watch"

# ─── ERP Alerts ───────────────────────────────────────────────────────────────
ALERT_EMAIL_TO="office@studiobotema.com"
ENABLE_ALERT_DIGEST="true"
TZ="Europe/Sofia"

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"
